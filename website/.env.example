# Public API base URL, bundled at build time. Leave empty to disable submissions.
# Example for local development: http://127.0.0.1:8000
# The backend must enable PLAYGROUND_ENABLED and allow the website origin in CORS.
NEXT_PUBLIC_PLAYGROUND_API=

# Public marketing origin for metadata, sitemap, robots, and security.txt Canonical.
# Rebuild and redeploy after changing these settings (including static contact pages).
NEXT_PUBLIC_SITE_URL=https://seclume.tech
SECURITY_CONTACT_EMAIL=security@seclume.tech
CONTACT_EMAIL=hello@seclume.tech
PRIVACY_CONTACT_EMAIL=privacy@seclume.tech
